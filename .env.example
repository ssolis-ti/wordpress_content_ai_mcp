# =================================================================
# WordPress AI Content System (wp_mcp_content_ai) - Configuration Example
# =================================================================

# --- LLM API KEYS ---
# Google AI Studio API Key (Get at: https://aistudio.google.com/)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# OpenRouter API Key (Optional alternative)
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# NVIDIA NIM API Key (Optional alternative)
NVIDIA_API_KEY="YOUR_NVIDIA_API_KEY"

# --- IMAGE GENERATION (FAL.AI) ---
# Fal.ai API Key (Get at: https://fal.ai/)
FAL_KEY="YOUR_FAL_API_KEY"

# --- WORDPRESS API CREDENTIALS ---
# WordPress site REST API endpoint (e.g., https://myblog.com)
WP_URL="https://yourwordpresssite.com"
# WordPress admin username
WP_USERNAME="admin"
# WordPress Application Password (Users -> Profile -> Application Passwords)
WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx"
# Site display name (used in JSON-LD schema, defaults to WP_URL domain)
WP_SITE_NAME="My WordPress Site"
# Absolute URL to site logo image (optional, used in JSON-LD schema)
WP_SITE_LOGO=""
# Author name for JSON-LD schema (optional)
WP_AUTHOR_NAME="Content Team"
# Author URL for JSON-LD schema (optional)
WP_AUTHOR_URL=""

# --- CORE LLM SETTINGS ---
# Active model identifier (e.g. google/gemini-2.5-pro or openai/meta/llama-3.1-8b-instruct)
MODEL="google/gemini-2.5-pro"
# Custom LLM API endpoint base if using proxy
OPENAI_API_BASE=""

# --- SYSTEM SETTINGS ---
PYTHONIOENCODING=utf-8
DEBUG=false
